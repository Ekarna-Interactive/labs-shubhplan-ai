# Shubh Plan Web — Environment Configuration Example

# Server listening port (default: 3000)
PORT=3000

# Application Execution Mode (server for local/on-premise vs demo for Fly.io BYOK)
APP_MODE=server

# Google Gemini API Key for server mode (Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Google Maps Places API Key for venue search & photo references
GOOGLE_MAPS_API_KEY=

# (Optional) Persistence directory for store.json and users.json (Defaults to ./data)
SHUBH_DATA_DIR=./data
