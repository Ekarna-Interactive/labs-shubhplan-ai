# ==============================================================================
# Shubh Plan AI — Open Source Engine Environment Configuration Template
# ==============================================================================
# Get free Gemini API key: https://aistudio.google.com/api-keys
# Get optional Honcho API key: https://honcho.dev

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Models & Keys
# ------------------------------------------------------------------------------
# Default server-wide API key. If left empty, Web UI & SSH TUI prompt users
# to supply their own keys via browser localStorage / terminal setup wizard.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ------------------------------------------------------------------------------
# 2. Honcho Memory Integration
# ------------------------------------------------------------------------------
# Optional Honcho Cloud Memory REST Driver Key. If left empty, Shubh Plan AI
# operates with the Inbuilt Local Memory Store (./data/honcho_memory.json).
HONCHO_API_KEY=your_honcho_api_key_here
HONCHO_APP_ID=shubh-plan-ai

# ------------------------------------------------------------------------------
# 3. Server Configuration & Privacy Modes
# ------------------------------------------------------------------------------
# Set SERVER_MODE=true or MULTI_USER=true when deploying to public servers.
# This prevents client browser keys from overwriting the server's disk .env file.
SERVER_MODE=false
MULTI_USER=false

# ------------------------------------------------------------------------------
# 4. Networking Ports & Storage Paths
# ------------------------------------------------------------------------------
PORT=3000
SSH_PORT=2222
SHUBH_OUTPUT_DIR=./output
SHUBH_DATA_DIR=./data
